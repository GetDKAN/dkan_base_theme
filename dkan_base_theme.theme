<?php

/**
 * @file
 * Theme hooks for DKAN Base.
 */

use Drupal\Component\Utility\UrlHelper;
use Drupal\Core\Cache\Cache;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;

/**
 * Implements hook_preprocess_HOOK() for page templates.
 */
function dkan_base_theme_preprocess_page(array &$variables): void {
  $variables['dbt_search'] = dkan_base_theme_header_search();
  // The site logo (theme setting or logo.svg) for the footer wordmark.
  $variables['dbt_logo'] = theme_get_setting('logo.url') ?: NULL;
  // Tagged on the page, not only on the form, so a page cached while the
  // search path was empty or invalid is invalidated when it is corrected.
  // Both the active theme's and the base theme's settings are read.
  $active = \Drupal::theme()->getActiveTheme()->getName();
  $variables['#cache']['tags'][] = "config:$active.settings";
  $variables['#cache']['tags'][] = 'config:dkan_base_theme.settings';
}

/**
 * The catalog search path for a theme: its own setting, else the base's.
 *
 * ThemeSettingsProvider merges base theme info.yml settings but not base
 * theme settings config, so a subtheme without a saved value inherits the
 * base theme's here. An empty string is a saved value and hides the form.
 */
function dkan_base_theme_search_path(?string $theme = NULL): string {
  $path = theme_get_setting('catalog_search_path', $theme);
  if ($path === NULL && $theme !== 'dkan_base_theme') {
    $path = theme_get_setting('catalog_search_path', 'dkan_base_theme');
  }
  return trim((string) $path);
}

/**
 * Builds the header search form, or NULL when the setting is empty.
 *
 * A plain GET form so no core search module is needed; the `fulltext`
 * parameter matches the dkan_catalog_ui search view's exposed filter.
 * External values (a scheme or a `//` prefix) hide the form and are logged
 * instead of throwing, so no setting value can take the page down.
 */
function dkan_base_theme_header_search(): ?array {
  $path = dkan_base_theme_search_path();
  if ($path === '') {
    return NULL;
  }
  $url = NULL;
  if (!UrlHelper::isExternal($path)) {
    try {
      $url = Url::fromUserInput('/' . ltrim($path, '/'));
    }
    catch (\InvalidArgumentException) {
      // Falls through to the warning below.
    }
  }
  if (!$url) {
    \Drupal::logger('dkan_base_theme')->warning('The catalog search path "@path" is not an internal path; the header search form is hidden.', ['@path' => $path]);
    return NULL;
  }
  return [
    '#type' => 'inline_template',
    '#template' => '<form class="dbt-header-search" role="search" method="get" action="{{ action }}">'
    . '<label class="visually-hidden" for="dbt-header-search">{{ "Search datasets"|t }}</label>'
    . '<input id="dbt-header-search" class="dbt-header-search__input" type="search" name="fulltext" placeholder="{{ "Search datasets"|t }}">'
    . '<button class="dbt-header-search__submit" type="submit">'
    . '{{ include("dkan_catalog_ui:icon", {name: "search"}, with_context = false) }}'
    . '<span class="visually-hidden">{{ "Search"|t }}</span></button>'
    . '</form>',
    '#context' => ['action' => $url->toString()],
    '#cache' => [
      'tags' => [
        'config:' . \Drupal::theme()->getActiveTheme()->getName() . '.settings',
        'config:dkan_base_theme.settings',
      ],
    ],
  ];
}

/**
 * Implements hook_form_FORM_ID_alter() for the theme settings form.
 */
function dkan_base_theme_form_system_theme_settings_alter(array &$form, FormStateInterface $form_state): void {
  // The theme being edited: this alter also runs for subthemes.
  $theme = $form_state->getBuildInfo()['args'][0] ?? 'dkan_base_theme';
  $form['dkan_base_theme'] = [
    '#type' => 'details',
    '#title' => t('DKAN Base'),
    '#open' => TRUE,
  ];
  $form['dkan_base_theme']['catalog_search_path'] = [
    '#type' => 'textfield',
    '#title' => t('Catalog search path'),
    '#description' => t('Internal path the header search form submits to, such as <code>/search</code>, with the term in the <code>fulltext</code> parameter. Leave empty to hide the form.'),
    '#default_value' => dkan_base_theme_search_path($theme),
    '#element_validate' => ['dkan_base_theme_validate_search_path'],
  ];
  $form['#submit'][] = 'dkan_base_theme_settings_submit';
}

/**
 * Submit handler: invalidate the theme's settings tag after the first save.
 *
 * Config::save() does not invalidate cache tags for a config object that
 * did not exist yet, so pages tagged with a subtheme's settings would keep
 * the inherited value until something else cleared them.
 */
function dkan_base_theme_settings_submit(array &$form, FormStateInterface $form_state): void {
  $theme = $form_state->getBuildInfo()['args'][0] ?? 'dkan_base_theme';
  Cache::invalidateTags(["config:$theme.settings"]);
}

/**
 * Element validator: the catalog search path must be internal or empty.
 */
function dkan_base_theme_validate_search_path(array $element, FormStateInterface $form_state): void {
  $value = trim((string) ($element['#value'] ?? ''));
  if ($value !== '' && UrlHelper::isExternal($value)) {
    $form_state->setError($element, t('The catalog search path must be an internal path such as <code>/search</code>.'));
  }
}
